+def classify_stage(curl_exit, http_code, sb_log):
+    """失败按阶段分类。返回 (stage, detail)。
+    stage/detail 均为枚举化白名单值，不含原始日志文本，可直接持久化。
+    注意顺序：TLS 必须在 DNS 之前判定（TLS 证书失败的日志里可能含 DNS 字样）。"""
+    if http_code not in ("000", "") and http_code.isdigit() and int(http_code) != 0:
+        return ("pass", "http-" + http_code)
+    log = sb_log or ""
+    ll = log.lower()
+    if "unexpected http response status: 403" in ll or "http response status: 403" in ll:
+        return ("http", "relay-403")
+    if "http response status:" in ll:
+        m = re.search(r"http response status:\s*(\d+)", ll)
+        return ("http", "relay-http-" + (m.group(1) if m else "?"))
+    if "connection refused" in ll:
+        return ("tcp", "connection-refused")
+    if "tls" in ll and ("handshake" in ll or "alert" in ll or "certificate" in ll
+                        or "failed to verify" in ll):
+        return ("tls", "tls-verify")
+    if "no such host" in ll or "server misbehaving" in ll or "dns query failed" in ll:
+        return ("dns", "dns-fail")
+    if "timeout" in ll or "timed out" in ll or "i/o timeout" in ll:
+        return ("timeout", "singbox-timeout")
+    if curl_exit == 28:
+        return ("timeout", "curl-timeout-28")
+    if curl_exit == 7:
+        return ("tcp", "curl-connect-7")
+    if curl_exit == 6:
+        return ("dns", "curl-dns-6")
+    if curl_exit == 97:
+        return ("socks", "curl-socks-97")
+    if curl_exit not in (0, None):
+        return ("other", "curl-exit-" + str(curl_exit))
+    return ("other", "unknown")
+
+
+def _diag(curl_exit=None, http_code="", stage="", detail="", timings=None):
+    t = timings or {}
+    return {"curl_exit": curl_exit, "http_code": http_code, "stage": stage,
+            "detail": detail, "lookup_ms": round(float(t.get("lookup", 0)) * 1000, 1),
+            "connect_ms": round(float(t.get("connect", 0)) * 1000, 1),
+            "appconnect_ms": round(float(t.get("appconnect", 0)) * 1000, 1),
+            "total_ms": round(float(t.get("total", 0)) * 1000, 1)}
+
+
+def _create_log_file(path):
+    """只创建新的私有stderr日志；拒绝已有路径和符号链接，绝不截断。"""
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
+    fd = os.open(path, flags, 0o600)
+    return os.fdopen(fd, "w")
+
+
+def _close_errf(errf):
+    if errf is not None:
+        try:
+            errf.close()
+        except Exception:
+            pass
+
+
+def _stop_proc(proc):
+    """终止子进程：先 terminate 等 2 秒，再 kill。返回 None。"""
+    if proc is None:
+        return
+    try:
+        proc.terminate()
+        proc.wait(timeout=2)
+    except Exception:
+        try:
+            proc.kill()
+        except Exception:
+            pass
+        try:
+            proc.wait(timeout=2)
+        except Exception:
+            pass
+
+
+def _read_error_lines(path, max_bytes=LOG_MAX_BYTES, max_lines=LOG_MAX_LINES):
+    """有界读取 sing-box 日志：只读文件末尾 max_bytes，只保留 ERROR 行，
+    最多 max_lines 行。返回拼接后的文本（仅内存使用，不持久化）。"""
+    try:
+        size = os.path.getsize(path)
+    except OSError:
+        return ""
+    try:
+        with open(path, "r", errors="ignore") as f:
+            if size > max_bytes:
+                f.seek(size - max_bytes)
+                f.readline()  # 丢弃可能不完整的首行
+            lines = [ln for ln in f if "ERROR" in ln]
+    except OSError:
+        return ""
+    return "".join(lines[-max_lines:])
+
